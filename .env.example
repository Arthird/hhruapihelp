# MAX Bot API
MAX_BOT_API_KEY=replace-with-max-bot-token
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_ROOT_CA_PATH=/etc/ssl/certs/russian_trusted_root_ca.pem

# Backend <-> max-bot
BACKEND_BASE_URL=http://backend:8000
INTERNAL_API_TOKEN=replace-with-long-random-token
BACKEND_TIMEOUT_SECONDS=60

# PostgreSQL
POSTGRES_DB=hh_api_help
POSTGRES_USER=hh_api_help
POSTGRES_PASSWORD=replace-with-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://hh_api_help:replace-with-database-password@db:5432/hh_api_help

# Yandex Cloud / Yandex Assistant
YANDEX_CLOUD_API_KEY=replace-with-yandex-api-key
YANDEX_CLOUD_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_CLOUD_FOLDER=replace-with-folder-id
MODEL_NAME=gpt://replace-with-folder-id/yandexgpt/latest
EMBEDDING_MODEL_NAME=text-search-doc
EMBEDDING_DIM=256
EMBEDDING_API_BASE=https://ai.api.cloud.yandex.net/v1

# RAG and application
KNOWLEDGE_PATH=backend/data/hh_api.md
KNOWLEDGE_SOURCE_PATH=doc_preparing/output/openapi.md
PROMPT_PATH=prompts/initial.md
RAG_TOP_K=5
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
PGVECTOR_ENABLED=true
LOG_LEVEL=INFO
